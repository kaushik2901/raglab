# Postgres 
DATABASE_URL=postgres://rag:rag@localhost:5432/rag?sslmode=disable
PG_USER=rag
PG_PASSWORD=rag
PG_DB=rag

# Qdrant 
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=

# LLM Provider: openai (default), gemini, openrouter, lmstudio
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI (also fallback for --llm-provider openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=

# OpenRouter (OpenAI-compatible)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# LM Studio (local, no API key)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Legacy fallback (used only when LLM_PROVIDER=openai and OPENAI_* vars are empty)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Embedding & Judge Defaults 
EMBEDDING_MODEL=text-embedding-3-small
JUDGE_PROVIDER=
JUDGE_MODEL=

# Rate Limiting (RPM = requests per minute), Match these to your API tier to avoid reactive 429 retries.
EMBEDDER_RATE_LIMIT_RPM=500
GENERATOR_RATE_LIMIT_RPM=30

# System 
WORKER_CONCURRENCY=1
MAX_RETRIES=3
RETRY_BACKOFF=5s
LOG_LEVEL=info
GOMEMLIMIT=5GiB
